    <string name="cd_close">Close</string>
    <string name="cd_settings">Settings</string>
    <string name="cd_about">About</string>

    <!-- Home: where the connection stands. %1$s is the adapter's own Bluetooth name -->
    <string name="home_no_adapter">Pair the adapter in the phone\'s Bluetooth settings, then choose it here. Most take the PIN 1234.</string>
    <string name="home_not_connected">Not connected to %1$s.</string>
    <string name="home_connecting">Connecting to %1$s…</string>
    <string name="home_asking">%1$s is connected. Asking the car…</string>
    <string name="home_silent">%1$s is connected, but the car is not answering. Is the key at on?</string>
    <string name="home_ready">Talking to the car through %1$s.</string>
    <string name="home_failed">Could not reach %1$s. Is it plugged in, with the key at on?</string>
    <string name="home_lost">Lost the connection to %1$s.</string>
    <string name="home_bluetooth_off">Bluetooth is off.</string>
    <string name="home_no_permission">The app needs permission to use Bluetooth to reach the adapter, and for nothing else.</string>

