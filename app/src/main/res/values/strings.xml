    <string name="home_choose_adapter">Choose the adapter</string>
    <string name="home_allow">Allow Bluetooth</string>
    <string name="home_open_bluetooth">Open Bluetooth settings</string>

    <!-- Home: the four things the car can be asked for -->
    <string name="home_codes">Trouble codes</string>
    <string name="home_live">Live data</string>
    <string name="home_freeze">Freeze frame</string>
    <string name="home_info">Vehicle information</string>

    <!-- Trouble codes -->
    <string name="codes_lamp_on">The check-engine light is on.</string>
    <string name="codes_lamp_off">The check-engine light is off.</string>
    <string name="codes_reading">Reading the codes…</string>
    <string name="codes_none">No trouble codes.</string>
    <string name="codes_kind_stored">Stored</string>
    <string name="codes_kind_pending">Pending — seen once, not yet confirmed</string>
    <string name="codes_kind_permanent">Permanent — the car clears this itself once the fault is gone</string>
    <string name="codes_read_again">Read them again</string>
    <string name="codes_clear">Clear the codes</string>
    <!-- The armed state of the row above: a second tap clears. The warning takes the dash, the prompt the semicolon -->
    <string name="codes_clear_armed">Clear — this also resets the emissions readiness; tap again</string>
    <string name="codes_clearing">Clearing…</string>
    <string name="codes_cleared">Cleared.</string>
    <string name="codes_refused_running">The car would not clear them. Most will only with the key at on and the engine off.</string>
    <string name="codes_refused_unsupported">The car would not clear them. It does not take that request from this kind of tool.</string>
    <!-- %1$s is the number the car gave as its reason, in hexadecimal, like 0x31 -->
    <string name="codes_refused_other">The car would not clear them, and gave reason %1$s.</string>
    <string name="codes_no_answer">The car did not say whether it cleared them. Reading them again shows which.</string>

    <!-- The pages of numbers -->
    <string name="readings_waiting">Waiting for the car…</string>
    <string name="freeze_note">The engine as it was when the first stored code was set.</string>
    <string name="live_none">The car is not sending any live data.</string>
    <string name="freeze_none">There is no freeze frame. A car keeps one only while a code is stored.</string>
    <string name="info_none">The car does not report any.</string>
    <string name="not_talking">Not talking to the car.</string>

