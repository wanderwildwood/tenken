    <!-- About dialog. Keep the names of the app, people, projects and licences as they are -->
    <string name="about_title">Car Check %1$s</string>
    <string name="about_privacy">What the car says stays on the phone. The app cannot reach the network at all.</string>
    <string name="about_sources">It reads the standard OBD-II diagnostics through an ELM327 adapter. What a maker keeps for its own tools is out of its reach.</string>
    <string name="about_after">After AndrOBD by fr3ts0n, whose ELM327 protocol and tables of codes and readings this carries.</string>
